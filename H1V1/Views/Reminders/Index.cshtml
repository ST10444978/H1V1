@{
    ViewData["Title"] = "Reminders";
}

<div class="page">

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Reminders
            </h1>

            <p class="page-subtitle">
                Stay on track with your deadlines and study sessions.
            </p>

        </div>

        <button class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            New Reminder
        </button>

    </div>


    <div class="card">

        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div>

                    <div class="item-title">
                        Database Assignment
                    </div>

                    <div class="item-subtitle">
                        Monday, 29 Sep · 09:00 AM
                    </div>

                </div>

            </div>

            <span class="badge badge-danger">
                High
            </span>

            <button>
                <i class="bi bi-check-lg"></i>
                Done
            </button>

            <button>
                <i class="bi bi-alarm"></i>
                Snooze
            </button>

        </div>


        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div>

                    <div class="item-title">
                        C# Test
                    </div>

                    <div class="item-subtitle">
                        Friday, 2 Oct · 09:00 AM
                    </div>

                </div>

            </div>

            <span class="badge badge-danger">
                High
            </span>

            <button>
                <i class="bi bi-check-lg"></i>
                Done
            </button>

            <button>
                <i class="bi bi-alarm"></i>
                Snooze
            </button>

        </div>


        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div>

                    <div class="item-title">
                        Study Plan Session
                    </div>

                    <div class="item-subtitle">
                        Sunday · 4 Oct · 10:00 AM
                    </div>

                </div>

            </div>

            <span class="badge badge-warning">
                Medium
            </span>

            <button>
                <i class="bi bi-check-lg"></i>
                Done
            </button>

            <button>
                <i class="bi bi-alarm"></i>
                Snooze
            </button>

        </div>

    </div>

</div>