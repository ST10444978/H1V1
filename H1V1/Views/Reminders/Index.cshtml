@{
    ViewData["Title"] = "Reminders";
}

<div class="page">

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Reminders
            </h1>

            <p class="page-subtitle">
                Stay on track with your deadlines and study sessions.
            </p>

        </div>

        <button class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            New Reminder
        </button>

    </div>


    <div class="card" id="remindersContainer">

        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div>

                    <div class="item-title">
                        Database Assignment
                    </div>

                    <div class="item-subtitle">
                        Monday, 29 Sep · 09:00 AM
                    </div>

                </div>

            </div>

            <span class="badge badge-danger">
                High
            </span>

            <button>
                <i class="bi bi-check-lg"></i>
                Done
            </button>

            <button>
                <i class="bi bi-alarm"></i>
                Snooze
            </button>

        </div>


        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div>

                    <div class="item-title">
                        C# Test
                    </div>

                    <div class="item-subtitle">
                        Friday, 2 Oct · 09:00 AM
                    </div>

                </div>

            </div>

            <span class="badge badge-danger">
                High
            </span>

            <button>
                <i class="bi bi-check-lg"></i>
                Done
            </button>

            <button>
                <i class="bi bi-alarm"></i>
                Snooze
            </button>

        </div>


        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div>

                    <div class="item-title">
                        Study Plan Session
                    </div>

                    <div class="item-subtitle">
                        Sunday · 4 Oct · 10:00 AM
                    </div>

                </div>

            </div>

            <span class="badge badge-warning">
                Medium
            </span>

            <button>
                <i class="bi bi-check-lg"></i>
                Done
            </button>

            <button>
                <i class="bi bi-alarm"></i>
                Snooze
            </button>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        async function loadRemindersList() {
            try {
                const response = await fetch('/api/reminders');
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                const reminders = await response.json();
                if (Array.isArray(reminders) && reminders.length > 0) {
                    const container = document.getElementById('remindersContainer');
                    container.innerHTML = reminders.map(r => `
                        <div class="list-item">
                            <div class="item-left">
                                <div class="item-icon">
                                    <i class="bi bi-journal-text"></i>
                                </div>
                                <div>
                                    <div class="item-title">${r.title}</div>
                                    <div class="item-subtitle">${r.dateTimeDisplay}</div>
                                </div>
                            </div>
                            <span class="badge ${r.priority === 'High' ? 'badge-danger' : 'badge-warning'}">
                                ${r.priority}
                            </span>
                            <button><i class="bi bi-check-lg"></i> Done</button>
                            <button><i class="bi bi-alarm"></i> Snooze</button>
                        </div>
                    `).join('');
                }
            } catch (error) {
                console.error("Error loading reminders:", error);
            }
        }

        document.addEventListener("DOMContentLoaded", loadRemindersList);
    </script>
}
