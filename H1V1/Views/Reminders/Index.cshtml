@{
    ViewData["Title"] = "Reminders";
}

<div class="page">

    <!-- Page Header -->
    <div class="page-header">

        <div>
            <h1 class="page-title">
                Reminders
            </h1>

            <p class="page-subtitle">
                Stay on track with your deadlines and study sessions.
            </p>
        </div>

        <button type="button" class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span>New Reminder</span>
        </button>

    </div>


    <!-- Reminders Card -->
    <div class="card reminders-card">

        <!-- Reminder 1 -->
        <div class="list-item reminder-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div class="reminder-info">

                    <div class="item-title">
                        Database Assignment
                    </div>

                    <div class="item-subtitle">
                        Monday, 29 Sep · 09:00 AM
                    </div>

                </div>

            </div>


            <div class="reminder-actions">

                <span class="badge badge-danger reminder-priority">
                    High
                </span>

                <button type="button" class="btn-reminder btn-done">
                    <i class="bi bi-check-lg"></i>
                    <span>Done</span>
                </button>

                <button type="button" class="btn-reminder btn-snooze">
                    <i class="bi bi-alarm"></i>
                    <span>Snooze</span>
                </button>

            </div>

        </div>


        <!-- Reminder 2 -->
        <div class="list-item reminder-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div class="reminder-info">

                    <div class="item-title">
                        C# Test
                    </div>

                    <div class="item-subtitle">
                        Friday, 2 Oct · 09:00 AM
                    </div>

                </div>

            </div>


            <div class="reminder-actions">

                <span class="badge badge-danger reminder-priority">
                    High
                </span>

                <button type="button" class="btn-reminder btn-done">
                    <i class="bi bi-check-lg"></i>
                    <span>Done</span>
                </button>

                <button type="button" class="btn-reminder btn-snooze">
                    <i class="bi bi-alarm"></i>
                    <span>Snooze</span>
                </button>

            </div>

        </div>


        <!-- Reminder 3 -->
        <div class="list-item reminder-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div class="reminder-info">

                    <div class="item-title">
                        Study Plan Session
                    </div>

                    <div class="item-subtitle">
                        Sunday · 4 Oct · 10:00 AM
                    </div>

                </div>

            </div>


            <div class="reminder-actions">

                <span class="badge badge-warning reminder-priority">
                    Medium
                </span>

                <button type="button" class="btn-reminder btn-done">
                    <i class="bi bi-check-lg"></i>
                    <span>Done</span>
                </button>

                <button type="button" class="btn-reminder btn-snooze">
                    <i class="bi bi-alarm"></i>
                    <span>Snooze</span>
                </button>

            </div>

        </div>

    </div>

</div>