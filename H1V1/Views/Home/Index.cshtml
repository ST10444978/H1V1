@model H1V1.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page">

    <div class="page-header">

        <div>
            <h1 class="page-title">
                Good morning, @Model.StudentName!
                <i class="bi bi-hand-wave"></i>
            </h1>

            <p class="page-subtitle">
                Here's what's happening with your studies today.
            </p>
        </div>

    </div>


    <!-- STAT CARDS -->

    <div class="stat-grid">

        <div class="stat-card blue">
            <div>
                <i class="bi bi-calendar-event"></i>
            </div>

            <div class="stat-value">
                @Model.AssessmentsDueCount
            </div>

            <div class="stat-label">
                Assessments Due Soon
            </div>

            <small>
                <a asp-controller="Assessments" asp-action="Index">View all <i class="bi bi-arrow-right"></i></a>
            </small>

        </div>

    </div>


    <!-- LOWER CONTENT -->

    <div class="content-grid">

        <div class="card">

            <div class="page-header">

                <strong>
                    Upcoming Assessments
                </strong>

                <a asp-controller="Assessments" asp-action="Index">
                    View all <i class="bi bi-arrow-right"></i>
                </a>

            </div>

            @if (Model.UpcomingAssessments.Any())
            {
                @foreach (var item in Model.UpcomingAssessments)
                {
                    var daysLeft = (item.DueDate - DateTime.Now).Days;
                    var badgeClass = daysLeft <= 3 ? "badge-danger" : (daysLeft <= 7 ? "badge-warning" : "badge-success");
                    <div class="list-item">

                        <div class="item-left">

                            <div class="item-icon">
                                <i class="bi bi-journal-text"></i>
                            </div>

                            <div>

                                <div class="item-title">
                                    @item.Title
                                </div>

                                <div class="item-subtitle">
                                    @item.CourseCode · Due @item.DueDate.ToString("MMM dd, yyyy")
                                </div>

                            </div>

                        </div>

                        <span class="badge @badgeClass">
                            @(daysLeft >= 0 ? $"{daysLeft} days left" : "Overdue")
                        </span>

                    </div>
                }
            }
            else
            {
                <p>No upcoming assessments found.</p>
            }

        </div>


        <!-- AI CARD -->

        <div class="card">

            <h3>
                <i class="bi bi-robot"></i>
                EduBuddy Recommendations
            </h3>

            <p>
                You have @Model.AssessmentsDueCount assessment(s) due soon.
                Would you like me to generate a study
                plan for your upcoming assessments?
            </p>

            <a asp-controller="AiAgent" asp-action="Index" class="btn-primary" style="display:inline-block; text-decoration:none;">
                Generate Study Plan
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>


    <br />

    <div class="card">

        <i class="bi bi-lightbulb"></i>

        <strong>
            Stay consistent!
        </strong>

        Small steps lead to big results.

    </div>

</div>
