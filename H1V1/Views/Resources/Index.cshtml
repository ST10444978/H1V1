@{
    ViewData["Title"] = "Resources";
}

<div class="page">

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Recommended Resources
            </h1>

            <p class="page-subtitle">
                Curated by EduBuddy based on your upcoming
                assessments and study plan.
            </p>

        </div>

        <select>
            <option>All Subjects</option>
            <option>Programming</option>
            <option>Database Systems</option>
            <option>Web Development</option>
        </select>

    </div>


    <div class="card">

        <div style="margin-bottom:20px;">

            <button class="btn-primary">
                All
            </button>

            <button>Videos</button>
            <button>Articles</button>
            <button>Practice</button>
            <button>Books</button>

        </div>


        <h3>
            Recommended for: C# Test
        </h3>


        <div class="content-grid">

            <div class="card">

                <div class="item-icon">
                    ▶
                </div>

                <h3>
                    C# Classes & Objects
                </h3>

                <p>
                    Learn the fundamentals of C# classes,
                    objects and methods.
                </p>

                <small>
                    Video · 12 min
                </small>

                <br><br>

                <button class="btn-primary">
                    View Resource
                </button>

            </div>


            <div class="card">

                <div class="item-icon">
                    ▶
                </div>

                <h3>
                    C# OOP Revision
                </h3>

                <p>
                    Quick revision on Object-Oriented
                    Programming concepts.
                </p>

                <small>
                    Video · 25 min
                </small>

                <br><br>

                <button class="btn-primary">
                    View Resource
                </button>

            </div>

        </div>

    </div>

</div>