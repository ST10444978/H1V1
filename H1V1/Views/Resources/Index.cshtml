@{
    ViewData["Title"] = "Recommended Resources";
}

<div class="page">

    <div class="page-header">

        <div>
            <h1 class="page-title">
                Recommended Resources
            </h1>
            <p class="page-subtitle">
                Curated by EduBuddy based on your upcoming assessments and study plan.
            </p>
        </div>

        <div>
            <input id="resource-topic-input" type="text" class="search" placeholder="Enter topic (e.g. Data Structures)..." style="width:250px; display:inline-block;" />
            <button class="btn-primary" onclick="searchTopicResources()">
                Search Resources
            </button>
        </div>

    </div>

    <div class="card">
        <div id="resources-results-container">
            <h3>Resources Results</h3>
            <p id="resources-status">Click Search Resources or ask EduBuddy via AI Chat to find relevant study materials.</p>
            <div id="resources-grid" class="content-grid"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        async function searchTopicResources() {
            const topicInput = document.getElementById("resource-topic-input");
            const statusEl = document.getElementById("resources-status");
            const grid = document.getElementById("resources-grid");

            const topic = topicInput ? topicInput.value.trim() : "Data Structures";
            if (!topic) return;

            statusEl.innerText = `Searching resources for '${topic}' via AI Chat agent...`;
            grid.innerHTML = "";

            try {
                const res = await fetch("/api/chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ studentId: 1, prompt: `Search resources for ${topic}` })
                });

                if (res.ok) {
                    const data = await res.json();
                    statusEl.innerHTML = `<strong>Search Results:</strong>`;
                    grid.innerHTML = `<div class="card" style="grid-column: 1 / -1;"><p style="white-space: pre-wrap;">${escapeHtml(data.response)}</p></div>`;
                } else {
                    statusEl.innerText = "Error searching resources.";
                }
            } catch (err) {
                statusEl.innerText = "Error connecting to AI API: " + err.message;
            }
        }

        function escapeHtml(str) {
            return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
}
