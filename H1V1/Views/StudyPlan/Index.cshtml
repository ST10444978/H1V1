@{
    ViewData["Title"] = "Study Plan";
}

<div class="page">

    <div class="page-header">

        <div>

            <h1 class="page-title">
                My Study Plan
            </h1>

            <p class="page-subtitle">
                AI-generated plan based on your assessments
                and available time.
            </p>

        </div>

        <button class="btn-primary">
            <i class="bi bi-arrow-clockwise"></i>
            Regenerate Plan
        </button>

    </div>


    <div class="content-grid">

        <div class="card">

            <h3>
                This Weekend
            </h3>


            <div class="list-item">

                <div>

                    <strong>
                        09:00 – 10:30
                    </strong>

                    <p>
                        C# Test Revision
                    </p>

                    <small>
                        Study · 90 min
                    </small>

                </div>

                <span class="badge badge-success">
                    Focus
                </span>

            </div>


            <div class="list-item">

                <div>

                    <strong>
                        10:30 – 10:45
                    </strong>

                    <p>
                        Break
                    </p>

                    <small>
                        Break · 15 min
                    </small>

                </div>

                <span class="badge badge-success">
                    Break
                </span>

            </div>


            <div class="list-item">

                <div>

                    <strong>
                        10:45 – 12:00
                    </strong>

                    <p>
                        Database Research
                    </p>

                    <small>
                        Study · 75 min
                    </small>

                </div>

                <span class="badge badge-success">
                    Focus
                </span>

            </div>


            <div class="list-item">

                <div>

                    <strong>
                        12:00 – 12:30
                    </strong>

                    <p>
                        Lunch Break
                    </p>

                    <small>
                        Break · 30 min
                    </small>

                </div>

                <span class="badge badge-success">
                    Break
                </span>

            </div>

        </div>


        <div class="card">

            <h3>
                <i class="bi bi-lightbulb"></i>
                Plan Summary
            </h3>

            <p>
                Focus on your C# test first,
                then move to the database assignment.
            </p>

            <hr />

            <p>
                Total Study Time:
                <strong>3.5 hrs</strong>
            </p>

            <p>
                Break Time:
                <strong>0.5 hrs</strong>
            </p>

            <p>
                Sessions:
                <strong>4</strong>
            </p>

            <button class="btn-primary">
                <i class="bi bi-check-lg"></i>
                Mark as Complete
            </button>

        </div>

    </div>

</div>