@{
    ViewData["Title"] = "AI Agent";
}

<div class="page">

    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-robot"></i>
                EduBuddy AI
            </h1>
            <p class="page-subtitle">
                Your academic success assistant
            </p>
        </div>
    </div>

    <div class="card">

        <!-- CHAT CONTAINER -->
        <div id="chat-messages" style="display:flex; flex-direction:column; gap:20px; margin-bottom:25px; min-height: 200px; max-height: 500px; overflow-y: auto; padding-right: 10px;">

            <!-- INITIAL WELCOME MESSAGE -->
            <div style="display:flex; gap:15px;">
                <div class="avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div style="background:#f8fafc; padding:15px; border-radius:12px; border:1px solid #e2e8f0; max-width:650px;">
                    <strong style="color:#2563eb;">EduBuddy</strong>
                    <p style="margin-top:5px; margin-bottom:0;">Hello Moagi! I am your Academic Success Agent. I can help you check upcoming assessments, generate study schedules, search study resources, or set reminders. How can I help you today?</p>
                </div>
            </div>

        </div>

        <!-- ASSESSMENTS SUMMARY CARD -->
        <div class="content-grid" style="margin-bottom: 25px;">

            <div class="card">
                <h3>Your Pending Assessments</h3>
                <div id="pending-assessments-list">
                    <p style="color:#64748b;">Loading pending assessments...</p>
                </div>
            </div>

            <div class="card">
                <h3>
                    <i class="bi bi-calendar-event"></i>
                    Study Plan & Schedule
                </h3>
                <p>I can generate and save a study plan tailored to your upcoming assessments.</p>
                <button type="button" id="btn-view-study-plan" class="btn-primary">
                    View My Study Plan
                </button>
            </div>

        </div>

        <!-- QUICK ACTIONS -->
        <div class="quick-actions">

            <div class="quick-actions-header">
                <div>
                    <h3>Quick Actions</h3>
                    <p>Click a quick action to ask EduBuddy:</p>
                </div>
            </div>

            <div class="quick-actions-grid">

                <button type="button" class="quick-action" data-prompt="Find study resources for Data Structures and Calculus.">
                    <div class="quick-action-icon">
                        <i class="bi bi-book"></i>
                    </div>
                    <div class="quick-action-content">
                        <strong>Find Study Resources</strong>
                        <span>Find resources for your subjects</span>
                    </div>
                    <i class="bi bi-arrow-right quick-action-arrow"></i>
                </button>

                <button type="button" class="quick-action" data-prompt="What are my upcoming pending assessments?">
                    <div class="quick-action-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <div class="quick-action-content">
                        <strong>Check Assessments</strong>
                        <span>View upcoming deadlines</span>
                    </div>
                    <i class="bi bi-arrow-right quick-action-arrow"></i>
                </button>

                <button type="button" class="quick-action" data-prompt="Remind me about my upcoming C# test and Database Assignment.">
                    <div class="quick-action-icon">
                        <i class="bi bi-bell"></i>
                    </div>
                    <div class="quick-action-content">
                        <strong>Set a Reminder</strong>
                        <span>Never miss an important deadline</span>
                    </div>
                    <i class="bi bi-arrow-right quick-action-arrow"></i>
                </button>

                <button type="button" class="quick-action" data-prompt="Generate a customized study plan for me this weekend and save it.">
                    <div class="quick-action-icon">
                        <i class="bi bi-sliders"></i>
                    </div>
                    <div class="quick-action-content">
                        <strong>Adjust My Plan</strong>
                        <span>Change your study schedule</span>
                    </div>
                    <i class="bi bi-arrow-right quick-action-arrow"></i>
                </button>

            </div>

        </div>

        <!-- CHAT INPUT FORM -->
        <br />
        <form id="chat-form" onsubmit="event.preventDefault(); sendChatMessage();">
            <div style="display:flex; gap:10px;">
                <input id="chat-input"
                       type="text"
                       class="search"
                       style="flex:1"
                       placeholder="Ask EduBuddy anything..."
                       required />

                <button id="chat-submit-btn" type="submit" class="btn-primary">
                    Send
                    <i class="bi bi-send"></i>
                </button>
            </div>
        </form>

    </div>

</div>
