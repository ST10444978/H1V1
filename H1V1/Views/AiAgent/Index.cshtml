@{
    ViewData["Title"] = "AI Agent";
}

<div class="page">

    <div class="page-header">

        <div>

            <h1 class="page-title">
                <i class="bi bi-robot"></i>
                EduBuddy AI
            </h1>

            <p class="page-subtitle">
                Your academic success assistant
            </p>

        </div>

    </div>


    <div class="card">

        <!-- USER MESSAGE -->

        <div style="
            display:flex;
            justify-content:flex-end;
            margin-bottom:20px;">

            <div style="
                background:#edf2ff;
                padding:15px;
                border-radius:12px;
                max-width:600px;">

                I have a C# test Friday and a
                database assignment due Monday.

                <br><br>

                I have 4 hours available this weekend.

            </div>

        </div>


        <!-- AI RESPONSE -->

        <div style="
            display:flex;
            gap:15px;
            margin-bottom:25px;">

            <div class="avatar">
                <i class="bi bi-robot"></i>
            </div>

            <div>

                <strong>
                    EduBuddy
                </strong>

                <p>
                    I've analysed your workload.
                    Here's what I found:
                </p>

            </div>

        </div>


        <!-- ASSESSMENTS + PLAN -->

        <div class="content-grid">

            <div class="card">

                <h3>
                    Your Assessments
                </h3>

                <div class="list-item">

                    <div>

                        <strong>
                            C# Test
                        </strong>

                        <p>
                            Friday, 2 Oct
                        </p>

                    </div>

                    <span class="badge badge-danger">
                        High priority
                    </span>

                </div>


                <div class="list-item">

                    <div>

                        <strong>
                            Database Assignment
                        </strong>

                        <p>
                            Monday, 5 Oct
                        </p>

                    </div>

                    <span class="badge badge-danger">
                        High priority
                    </span>

                </div>

            </div>


            <div class="card">

                <h3>
                    <i class="bi bi-calendar-event"></i>
                    Recommended Study Plan
                </h3>

                <p>
                    I've created a study plan based on
                    your available time.
                </p>

                <button class="btn-primary">
                    View Study Plan
                </button>

            </div>

        </div>


        <!-- QUICK ACTIONS -->

        <div class="quick-actions">

            <div class="quick-actions-header">
                <div>
                    <h3>
                        Quick Actions
                    </h3>

                    <p>
                        You can also ask EduBuddy to:
                    </p>
                </div>
            </div>


            <div class="quick-actions-grid">

                <button type="button" class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-book"></i>
                    </div>

                    <div class="quick-action-content">

                        <strong>
                            Find Study Resources
                        </strong>

                        <span>
                            Find resources for your subjects
                        </span>

                    </div>

                    <i class="bi bi-arrow-right quick-action-arrow"></i>

                </button>


                <button type="button" class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                    <div class="quick-action-content">

                        <strong>
                            Check Assessments
                        </strong>

                        <span>
                            View upcoming deadlines
                        </span>

                    </div>

                    <i class="bi bi-arrow-right quick-action-arrow"></i>

                </button>


                <button type="button" class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-bell"></i>
                    </div>

                    <div class="quick-action-content">

                        <strong>
                            Set a Reminder
                        </strong>

                        <span>
                            Never miss an important deadline
                        </span>

                    </div>

                    <i class="bi bi-arrow-right quick-action-arrow"></i>

                </button>


                <button type="button" class="quick-action">

                    <div class="quick-action-icon">
                        <i class="bi bi-sliders"></i>
                    </div>

                    <div class="quick-action-content">

                        <strong>
                            Adjust My Plan
                        </strong>

                        <span>
                            Change your study schedule
                        </span>

                    </div>

                    <i class="bi bi-arrow-right quick-action-arrow"></i>

                </button>

            </div>

        </div>


        <!-- CHAT INPUT -->

        <br />

        <form asp-action="Chat"
              method="post">

            <div style="
                display:flex;
                gap:10px;">

                <input
                    name="message"
                    class="search"
                    style="flex:1"
                    placeholder="Ask EduBuddy anything..." />

                <button
                    type="submit"
                    class="btn-primary">

                    Send
                    <i class="bi bi-send"></i>

                </button>

            </div>

        </form>

    </div>

</div>