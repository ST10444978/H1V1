@{
    ViewData["Title"] = "Assessments";
}

<div class="page">

    <!-- Page Header -->
    <div class="page-header">

        <div>
            <h1 class="page-title">Assessments</h1>

            <p class="page-subtitle">
                Track your upcoming and past assessments.
            </p>
        </div>

        <button type="button" class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Add Assessment</span>
        </button>

    </div>


    <!-- Assessments Card -->
    <div class="card assessments-card">

        <!-- Tabs -->
        <div class="assessment-tabs">

            <button type="button" class="assessment-tab active">
                Upcoming <span>(3)</span>
            </button>

            <button type="button" class="assessment-tab">
                Past <span>(5)</span>
            </button>

        </div>


        <!-- Assessment 1 -->
        <div class="list-item assessment-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-database"></i>
                </div>

                <div class="assessment-info">
                    <div class="item-title">
                        Database Assignment
                    </div>

                    <div class="item-subtitle">
                        Database Systems
                    </div>
                </div>

            </div>

            <div class="assessment-meta">

                <div class="assessment-date">
                    <i class="bi bi-calendar3"></i>
                    <span>Mon, 29 Sep 2025</span>
                </div>

                <span class="badge badge-danger assessment-status">
                    3 days left
                </span>

                <button type="button" class="btn-view">
                    View
                    <i class="bi bi-chevron-right"></i>
                </button>

            </div>

        </div>


        <!-- Assessment 2 -->
        <div class="list-item assessment-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div class="assessment-info">
                    <div class="item-title">
                        C# Test
                    </div>

                    <div class="item-subtitle">
                        Programming
                    </div>
                </div>

            </div>

            <div class="assessment-meta">

                <div class="assessment-date">
                    <i class="bi bi-calendar3"></i>
                    <span>Wed, 30 Sep 2025</span>
                </div>

                <span class="badge badge-warning assessment-status">
                    5 days left
                </span>

                <button type="button" class="btn-view">
                    View
                    <i class="bi bi-chevron-right"></i>
                </button>

            </div>

        </div>


        <!-- Assessment 3 -->
        <div class="list-item assessment-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-globe2"></i>
                </div>

                <div class="assessment-info">
                    <div class="item-title">
                        Web Development Project
                    </div>

                    <div class="item-subtitle">
                        Web Development
                    </div>
                </div>

            </div>

            <div class="assessment-meta">

                <div class="assessment-date">
                    <i class="bi bi-calendar3"></i>
                    <span>Fri, 2 Oct 2025</span>
                </div>

                <span class="badge badge-success assessment-status">
                    7 days left
                </span>

                <button type="button" class="btn-view">
                    View
                    <i class="bi bi-chevron-right"></i>
                </button>

            </div>

        </div>

    </div>

</div>