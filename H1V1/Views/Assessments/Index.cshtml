@{
    ViewData["Title"] = "Assessments";
}

<div class="page">

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Assessments
            </h1>

            <p class="page-subtitle">
                Track your upcoming and past assessments.
            </p>

        </div>

        <button class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Assessment
        </button>

    </div>


    <div class="card">

        <div style="margin-bottom:20px;">

            <button class="btn-primary">
                Upcoming (3)
            </button>

            <button style="
                border:none;
                background:white;
                padding:10px 18px;">
                Past (5)
            </button>

        </div>


        <!-- Assessment -->

        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-database"></i>
                </div>

                <div>

                    <div class="item-title">
                        Database Assignment
                    </div>

                    <div class="item-subtitle">
                        Database Systems
                    </div>

                </div>

            </div>

            <div>
                Mon, 29 Sep 2025
            </div>

            <span class="badge badge-danger">
                3 days left
            </span>

            <button>
                View
            </button>

        </div>


        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div>

                    <div class="item-title">
                        C# Test
                    </div>

                    <div class="item-subtitle">
                        Programming
                    </div>

                </div>

            </div>

            <div>
                Wed, 30 Sep 2025
            </div>

            <span class="badge badge-warning">
                5 days left
            </span>

            <button>
                View
            </button>

        </div>


        <div class="list-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-globe2"></i>
                </div>

                <div>

                    <div class="item-title">
                        Web Development Project
                    </div>

                    <div class="item-subtitle">
                        Web Development
                    </div>

                </div>

            </div>

            <div>
                Fri, 2 Oct 2025
            </div>

            <span class="badge badge-success">
                7 days left
            </span>

            <button>
                View
            </button>

        </div>

    </div>

</div>