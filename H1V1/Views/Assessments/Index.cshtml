@{
    ViewData["Title"] = "Assessments";
}

<div class="page">

    <div class="page-header">

        <div>
            <h1 class="page-title">
                Assessments
            </h1>

            <p class="page-subtitle">
                Track your upcoming and past assessments.
            </p>
        </div>

        <button class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Assessment
        </button>

    </div>


    <div class="card">

        <div class="assessment-tabs">

            <button class="assessment-tab active">
                Upcoming (3)
            </button>

            <button class="assessment-tab">
                Past (5)
            </button>

        </div>


        <!-- Assessment -->

        <div class="list-item assessment-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-database"></i>
                </div>

                <div>
                    <div class="item-title">
                        Database Assignment
                    </div>

                    <div class="item-subtitle">
                        Database Systems
                    </div>
                </div>

            </div>

            <div class="assessment-date">
                Mon, 29 Sep 2025
            </div>

            <span class="badge badge-danger assessment-status">
                3 days left
            </span>

            <button class="btn-view">
                View
            </button>

        </div>


        <div class="list-item assessment-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div>
                    <div class="item-title">
                        C# Test
                    </div>

                    <div class="item-subtitle">
                        Programming
                    </div>
                </div>

            </div>

            <div class="assessment-date">
                Wed, 30 Sep 2025
            </div>

            <span class="badge badge-warning assessment-status">
                5 days left
            </span>

            <button class="btn-view">
                View
            </button>

        </div>


        <div class="list-item assessment-item">

            <div class="item-left">

                <div class="item-icon">
                    <i class="bi bi-globe2"></i>
                </div>

                <div>
                    <div class="item-title">
                        Web Development Project
                    </div>

                    <div class="item-subtitle">
                        Web Development
                    </div>
                </div>

            </div>

            <div class="assessment-date">
                Fri, 2 Oct 2025
            </div>

            <span class="badge badge-success assessment-status">
                7 days left
            </span>

            <button class="btn-view">
                View
            </button>

        </div>

    </div>

</div>